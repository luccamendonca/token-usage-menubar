<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- @APP_BINARY@ is substituted by `make install`. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.personal.ClaudeUsageToolbar</string>
	<key>ProgramArguments</key>
	<array>
		<string>@APP_BINARY@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/claude-usage-toolbar.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/claude-usage-toolbar.err</string>
</dict>
</plist>
